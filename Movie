/* =========================
   GENERAL
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #0b0b0f;
    color: #ffffff;
}

button,
input {
    font-family: inherit;
}

button {
    cursor: pointer;
}

/* =========================
   NAVBAR
========================= */

.navbar {
    width: 100%;
    height: 75px;
    background: rgba(10, 10, 14, 0.95);

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 6%;
    position: fixed;
    top: 0;
    z-index: 1000;

    border-bottom: 1px solid #222;
}

.logo {
    font-size: 27px;
    font-weight: bold;
    color: white;
}

.logo span {
    color: #e50914;
}

nav {
    display: flex;
    gap: 30px;
}

nav a {
    color: #ddd;
    text-decoration: none;
    font-size: 15px;
    transition: 0.3s;
}

nav a:hover {
    color: #e50914;
}

.search-box {
    display: flex;
    background: #1b1b21;
    border-radius: 25px;
    overflow: hidden;
}

.search-box input {
    width: 170px;
    padding: 10px 15px;
    border: none;
    outline: none;
    background: transparent;
    color: white;
}

.search-box button {
    width: 45px;
    border: none;
    background: #e50914;
    color: white;
}

/* =========================
   HERO
========================= */

.hero {
    min-height: 700px;
    padding: 180px 8% 100px;

    display: flex;
    align-items: center;

    background:
        linear-gradient(
            90deg,
            #0b0b0f 5%,
            rgba(11, 11, 15, 0.85) 35%,
            rgba(11, 11, 15, 0.2) 100%
        ),
        linear-gradient(
            180deg,
            transparent 70%,
            #0b0b0f 100%
        ),
        url("https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=1800&q=80");

    background-size: cover;
    background-position: center;
}

.hero-content {
    max-width: 600px;
}

.badge {
    display: inline-block;
    color: #e50914;
    font-weight: bold;
    margin-bottom: 15px;
    letter-spacing: 2px;
}

.hero h1 {
    font-size: clamp(45px, 7vw, 85px);
    line-height: 1;
    margin-bottom: 25px;
}

.hero p {
    color: #ccc;
    font-size: 17px;
    line-height: 1.7;
    margin-bottom: 30px;
}

.hero-buttons {
    display: flex;
    gap: 15px;
}

.watch-btn,
.info-btn {
    border: none;
    padding: 13px 24px;
    border-radius: 5px;
    font-weight: bold;
    transition: 0.3s;
}

.watch-btn {
    background: #e50914;
    color: white;
}

.watch-btn:hover {
    background: #ff1824;
    transform: translateY(-2px);
}

.info-btn {
    background: #ffffff;
    color: #111;
}

.info-btn:hover {
    background: #ddd;
}

/* =========================
   MOVIE SECTION
========================= */

.movie-section {
    padding: 70px 6%;
}

.section-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 30px;
    flex-wrap: wrap;
}

.section-header h2 {
    margin-right: auto;
    font-size: 30px;
}

.filter-btn {
    padding: 8px 16px;
    border: 1px solid #333;
    border-radius: 20px;
    background: #17171d;
    color: #ccc;
}

.filter-btn:hover,
.filter-btn.active {
    background: #e50914;
    border-color: #e50914;
    color: white;
}

/* =========================
   MOVIE GRID
========================= */

.movie-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 20px;
}

.movie-card {
    background: #15151b;
    border-radius: 10px;
    overflow: hidden;
    transition: 0.3s;
}

.movie-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.4);
}

.poster {
    height: 280px;
    position: relative;
    background-size: cover;
    background-position: center;
}

.poster-1 {
    background-image: url("https://images.unsplash.com/photo-1536440136628-849c177e76a1?auto=format&fit=crop&w=700&q=80");
}

.poster-2 {
    background-image: url("https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?auto=format&fit=crop&w=700&q=80");
}

.poster-3 {
    background-image: url("https://images.unsplash.com/photo-1485846234645-a62644f84728?auto=format&fit=crop&w=700&q=80");
}

.poster-4 {
    background-image: url("https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=700&q=80");
}

.poster-5 {
    background-image: url("https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=700&q=80");
}

.poster-6 {
    background-image: url("https://images.unsplash.com/photo-1485095329183-d0797cdc5676?auto=format&fit=crop&w=700&q=80");
}

.rating {
    position: absolute;
    top: 10px;
    right: 10px;

    background: #e50914;
    color: white;

    padding: 6px 9px;
    border-radius: 5px;
    font-weight: bold;
    font-size: 13px;
}

.movie-info {
    padding: 15px;
}

.movie-info h3 {
    font-size: 17px;
    margin-bottom: 7px;
}

.movie-info p {
    color: #888;
    font-size: 13px;
    margin-bottom: 15px;
}

.movie-info button {
    width: 100%;
    padding: 9px;

    background: transparent;
    border: 1px solid #444;
    color: white;
    border-radius: 5px;
}

.movie-info button:hover {
    background: #e50914;
    border-color: #e50914;
}

/* =========================
   POPULAR
========================= */

.popular {
    padding: 70px 6%;
    background: #101014;
}

.popular h2 {
    font-size: 30px;
    margin-bottom: 30px;
}

.popular-list {
    max-width: 850px;
}

.popular-item {
    display: flex;
    align-items: center;
    gap: 25px;

    padding: 20px;

    border-bottom: 1px solid #292930;
}

.popular-item > span {
    color: #e50914;
    font-size: 25px;
    font-weight: bold;
}

.popular-item div {
    flex: 1;
}

.popular-item h3 {
    margin-bottom: 5px;
}

.popular-item p {
    color: #888;
    font-size: 14px;
}

.popular-item strong {
    color: #ffd700;
}

/* =========================
   ABOUT
========================= */

.about {
    padding: 80px 6%;
    text-align: center;
}

.about h2 {
    font-size: 35px;
    margin-bottom: 20px;
}

.about p {
    max-width: 700px;
    margin: auto;
    color: #999;
    line-height: 1.8;
}

/* =========================
   FOOTER
========================= */

footer {
    padding: 35px 6%;
    background: #070709;

    display: flex;
    align-items: center;
    justify-content: space-between;

    border-top: 1px solid #222;
}

footer p {
    color: #666;
    font-size: 13px;
}

/* =========================
   MODAL
========================= */

.modal {
    display: none;

    position: fixed;
    inset: 0;

    background: rgba(0, 0, 0, 0.85);

    align-items: center;
    justify-content: center;

    z-index: 2000;
}

.modal.show {
    display: flex;
}

.modal-content {
    width: min(500px, 90%);
    background: #19191f;
    padding: 40px;
    border-radius: 12px;
    position: relative;
}

.modal-content h2 {
    margin-bottom: 15px;
    font-size: 30px;
}

.modal-content p {
    color: #aaa;
    line-height: 1.7;
    margin-bottom: 25px;
}

.close-btn {
    position: absolute;
    top: 15px;
    right: 18px;

    border: none;
    background: none;
    color: white;

    font-size: 30px;
}

/* =========================
   RESPONSIVE
========================= */

@media (max-width: 1100px) {
    .movie-grid {
        grid-template-columns: repeat(3, 1fr);
    }
}

@media (max-width: 800px) {
    .navbar {
        height: auto;
        padding: 15px 5%;
        flex-wrap: wrap;
        gap: 15px;
    }

    nav {
        order: 3;
        width: 100%;
        justify-content: center;
    }

    .hero {
        min-height: 600px;
    }

    .movie-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 500px) {
    .hero {
        padding-left: 5%;
        padding-right: 5%;
    }

    .hero h1 {
        font-size: 45px;
    }

    .movie-grid {
        grid-template-columns: 1fr;
    }

    .search-box input {
        width: 120px;
    }

    footer {
        flex-direction: column;
        gap: 15px;
    }

    .popular-item {
        gap: 12px;
    }
}

/* =========================
   MOVIE SEARCH
========================= */

const searchInput = document.getElementById("searchInput");
const searchBtn = document.getElementById("searchBtn");
const movieCards = document.querySelectorAll(".movie-card");

function searchMovies() {
    const searchTerm = searchInput.value.toLowerCase().trim();

    movieCards.forEach(card => {
        const movieName = card
            .querySelector("h3")
            .textContent
            .toLowerCase();

        if (movieName.includes(searchTerm)) {
            card.style.display = "block";
        } else {
            card.style.display = "none";
        }
    });
}

searchBtn.addEventListener("click", searchMovies);

searchInput.addEventListener("keyup", function(event) {
    if (event.key === "Enter") {
        searchMovies();
    }

    if (searchInput.value === "") {
        movieCards.forEach(card => {
            card.style.display = "block";
        });
    }
});


/* =========================
   MOVIE FILTER
========================= */

const filterButtons = document.querySelectorAll(".filter-btn");

filterButtons.forEach(button => {

    button.addEventListener("click", function() {

        filterButtons.forEach(btn => {
            btn.classList.remove("active");
        });

        this.classList.add("active");

        const selectedCategory = this.dataset.filter;

        movieCards.forEach(card => {

            const category = card.dataset.category;

            if (
                selectedCategory === "all" ||
                category === selectedCategory
            ) {
                card.style.display = "block";
            } else {
                card.style.display = "none";
            }

        });

    });

});


/* =========================
   MOVIE MODAL
========================= */

const modal = document.getElementById("movieModal");
const modalTitle = document.getElementById("modalTitle");
const modalDescription = document.getElementById("modalDescription");
const closeModal = document.getElementById("closeModal");

function showMovie(movieName) {

    modalTitle.textContent = movieName;

    modalDescription.textContent =
        `${movieName} is one of the featured movies on CineVerse. 
        Check out the trailer and discover more about this exciting movie.`;

    modal.classList.add("show");
}

closeModal.addEventListener("click", function() {
    modal.classList.remove("show");
});


/* Close modal when clicking outside */

modal.addEventListener("click", function(event) {

    if (event.target === modal) {
        modal.classList.remove("show");
    }

});


/* =========================
   TRAILER BUTTON
========================= */

function playTrailer() {

    alert(
        "🎬 Trailer player would open here.\n\n" +
        "You can replace this alert with a YouTube trailer URL."
    );
}


/* =========================
   NAVBAR ACTIVE LINK
========================= */

const navLinks = document.querySelectorAll("nav a");

navLinks.forEach(link => {

    link.addEventListener("click", function() {

        navLinks.forEach(item => {
            item.classList.remove("active");
        });

        this.classList.add("active");

    });

});

